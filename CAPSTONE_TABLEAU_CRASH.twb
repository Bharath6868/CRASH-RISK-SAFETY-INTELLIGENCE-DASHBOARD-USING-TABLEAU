      <aliases enabled='yes' />
      <column caption='Total Crash Reports' datatype='integer' name='[Calculation_1858297824046600192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([ACRS Report Type])' />
      </column>
      <column caption='Numbers of Persons' datatype='integer' name='[Calculation_1858297824054906883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([Person ID])' />
      </column>
      <column caption='Month-over-Month Change (%)' datatype='real' name='[Calculation_1858297824061222917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    COUNT(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [Crash_date])&#13;&#10;           = DATETRUNC(&apos;month&apos;, { FIXED : MAX([Crash_date]) })&#13;&#10;        THEN [Report Number]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    -&#13;&#10;    COUNT(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [Crash_date])&#13;&#10;           = DATEADD(&#13;&#10;                &apos;month&apos;,&#13;&#10;                -1,&#13;&#10;                DATETRUNC(&apos;month&apos;, { FIXED : MAX([Crash_date]) })&#13;&#10;             )&#13;&#10;        THEN [Report Number]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF DATETRUNC(&apos;month&apos;, [Crash_date])&#13;&#10;       = DATEADD(&#13;&#10;            &apos;month&apos;,&#13;&#10;            -1,&#13;&#10;            DATETRUNC(&apos;month&apos;, { FIXED : MAX([Crash_date]) })&#13;&#10;         )&#13;&#10;    THEN [Report Number]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Peak Crash Hour' datatype='integer' name='[Calculation_1858297824068403207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;    { FIXED [Crash_hour] : COUNT([Report Number]) }&#13;&#10;    =&#13;&#10;    { FIXED : MAX( { FIXED [Crash_hour] : COUNT([Report Number]) } ) }&#13;&#10;THEN [Crash_hour]&#13;&#10;END' />
      </column>
      <column caption='Max Crashes in Any Hour' datatype='integer' name='[Calculation_1858297824071221256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    { FIXED [Crash_hour] : COUNT([Report Number]) }&#13;&#10;) }' />
      </column>
      <column caption='Highest Risk Road' datatype='string' name='[Calculation_1858297824079888394]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(&#13;&#10;IF&#13;&#10;    { FIXED [Road Name] : COUNT([Report Number]) }&#13;&#10;    =&#13;&#10;    { FIXED : MAX( { FIXED [Road Name] : COUNT([Report Number]) } ) }&#13;&#10;THEN [Road Name]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Common Collision Type' datatype='string' name='[Calculation_1858297824080904203]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(&#13;&#10;IF&#13;&#10;    { FIXED [Collision Type] : COUNT([Report Number]) }&#13;&#10;    =&#13;&#10;    { FIXED : MAX( { FIXED [Collision Type] : COUNT([Report Number]) } ) }&#13;&#10;THEN [Collision Type]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Severe Injury Rate' datatype='real' name='[Calculation_1858297824082374668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Injury Severity] IN (&quot;Fatal Injury&quot;,&quot;Serious Injury&quot;)&#13;&#10;THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Report Number])' />
      </column>
      <column caption='Max Speed Observed' datatype='real' name='[Calculation_1858297824349995021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Speed Limit])' />
      </column>
